import yts from 'yt-search'
import fetch from 'node-fetch'

export default {
  name: 'play2',
  alias: ['mp4', 'ytmp4', 'ytvideo', 'playvideo'],
  description: 'Descargar un vídeo de YouTube con botones de calidad.',
  category: 'Descargas',
  usage: '<nombre o url>',

  async execute(sock, m, options) {
    try {
      const { args, config } = options;
      const from = m.key.remoteJid;
      const reply = (text) => sock.sendMessage(from, { text }, { quoted: m });

      if (!args[0]) return reply('《✧》Por favor, menciona el nombre o URL del video que deseas descargar');

      await sock.sendMessage(from, { react: { text: "🔍", key: m.key } });

      const input = args.join(' ').trim();
      const url = await getYoutubeUrl(input);

      // Primero sacamos info sin descargar
      const info = await getFareVideo(url + '&quality=360');
      if (!info?.status ||!info?.titulo) return reply('《✧》No se encontró el video.');

      const title = info.titulo || 'video';
      const channel = info.canal?.nombre || 'Desconocido';
      const duration = info.duracion || 'Desconocido';
      const views = Number(info.vistas || 0).toLocaleString('es-PE');
      const thumbnail = info.miniatura || null;

      const info_message = `乂 *SELECCIONA CALIDAD*

> ❖ Título › *${title}*
> ❖ Canal › *${channel}*
> ⴵ Duración › *${duration}*
> ❀ Vistas › *${views}*
> ❒ Enlace › *${url}*`;

      const contextInfo = {
        isForwarded: true,
        forwardedNewsletterMessageInfo: {
          newsletterJid: config.canalId || '120363408963824114@newsletter',
          serverMessageId: '0',
          newsletterName: config.canalNombre || 'CANAL OFICIAL'
        }
      };

      // BOTONES DE CALIDAD
      const buttons = [
        {
          name: "quick_reply",
          buttonParamsJson: JSON.stringify({
            display_text: "360p",
            id: `.getyt ${url}|360|${title}`
          })
        },
        {
          name: "quick_reply",
          buttonParamsJson: JSON.stringify({
            display_text: "720p HD",
            id: `.getyt ${url}|720|${title}`
          })
        },
        {
          name: "quick_reply",
          buttonParamsJson: JSON.stringify({
            display_text: "1080p FHD",
            id: `.getyt ${url}|1080|${title}`
          })
        }
      ];

      const msg = generateWAMessageFromContent(from, {
        viewOnceMessage: {
          message: {
            messageContextInfo: { deviceListMetadata: {}, deviceListMetadataVersion: 2 },
            interactiveMessage: proto.Message.InteractiveMessage.fromObject({
              body: { text: info_message },
              footer: { text: "✦ Elige la calidad para descargar ✦" },
              header: { hasMediaAttachment: true, imageMessage: thumbnail? await prepareWAMessageMedia({ image: { url: thumbnail } }, { upload: sock.waUploadToServer }) : undefined },
              nativeFlowMessage: { buttons }
            })
          }
        }
      }, { quoted: m });

      await sock.relayMessage(from, msg.message, { messageId: msg.key.id });
      await sock.sendMessage(from, { react: { text: "✅", key: m.key } });

    } catch (e) {
      console.error(e);
      const from = m.key.remoteJid;
      await sock.sendMessage(from, { text: `❌ Error: ${e.message}` }, { quoted: m });
    }
  }
}

// COMANDO SECUNDARIO PARA DESCARGAR CON LA CALIDAD ELEGIDA
export const getyt = {
  name: 'getyt',
  async execute(sock, m, options) {
    const { args } = options;
    const from = m.key.remoteJid;
    const reply = (text) => sock.sendMessage(from, { text }, { quoted: m });

    const [url, quality,...titleArr] = args.join(' ').split('|');
    const title = titleArr.join('|') || 'video';

    await sock.sendMessage(from, { react: { text: "📥", key: m.key } });
    await reply(`乂 *Descargando en ${quality}p...*`);

    try {
      const data = await getFareVideo(`${url}&quality=${quality}`);
      if (!data?.status ||!data?.descarga?.url) return reply('《✧》No se pudo descargar esa calidad.');

      const download = data.descarga;
      const file_name = sanitizeFileName(title) + '.mp4';
      const size_bytes = parseFileSize(download.tamaño);
      const size_text = size_bytes? formatBytes(size_bytes) : 'Desconocido';
      const send_as_document = size_bytes > 50 * 1024 * 1024;

      const caption = `乂 *VIDEO LISTO ${quality}p*

> ❒ Tamaño › *${size_text}*`;

      if (send_as_document) {
        await sock.sendMessage(from, { document: { url: download.url }, mimetype: 'video/mp4', fileName: file_name, caption }, { quoted: m });
      } else {
        await sock.sendMessage(from, { video: { url: download.url }, mimetype: 'video/mp4', fileName: file_name, caption }, { quoted: m });
      }
      await sock.sendMessage(from, { react: { text: "✅", key: m.key } });

    } catch (e) {
      await reply(`❌ Error: ${e.message}`);
    }
  }
}

const api_url = 'https://api.lempi.lat/dl/ytv?url='
const api_key = 'montekey28'

import { generateWAMessageFromContent, proto, prepareWAMessageMedia } from "@whiskeysockets/baileys";

async function getYoutubeUrl(input) {
  const id = getVideoId(input)
  if (id) return `https://youtu.be/${id}`
  if (isYTUrl(input)) return input
  const search = await yts(input)
  const video = search.videos?.[0] || search.all?.find(v => v.type === 'video')
  if (!video?.url) throw new Error('No se encontró un video válido de YouTube')
  return video.url
}

async function getFareVideo(url) {
  const res = await fetch(`${api_url}${encodeURIComponent(url)}&apikey=${api_key}`, {
    headers: { accept: 'application/json', 'user-agent': 'Mozilla/5.0' }
  })
  const text = await res.text()
  if (!res.ok) throw new Error(`API HTTP ${res.status}`)
  return JSON.parse(text)
}

function parseFileSize(size) {
  if (!size) return 0
  const raw = String(size).trim()
  const match = raw.match(/([\d.,]+)\s*(bytes?|b|kb|kib|mb|mib|gb|gib)/i)
  if (!match) return 0
  let value_text = match[1]
  if (value_text.includes(',') && value_text.includes('.')) value_text = value_text.replace(/,/g, '')
  else value_text = value_text.replace(',', '.')
  const value = Number(value_text)
  const unit = match[2].toLowerCase()
  const mult = { b: 1, kb: 1024, mb: 1024 ** 2, gb: 1024 ** 3 }
  return Math.round(value * (mult[unit] || 1))
}

function formatBytes(bytes = 0) {
  if (!bytes) return 'Desconocido'
  const units = ['B', 'KB', 'MB', 'GB']
  let size = Number(bytes)
  let unit = 0
  while (size >= 1024 && unit < units.length - 1) { size /= 1024; unit++ }
  return `${size.toFixed(unit === 0? 0 : 2)} ${units[unit]}`
}

const isYTUrl = url => /^(https?:\/\/)?(www\.)?(youtube\.com|youtu\.be)\/.+$/i.test(url)
function getVideoId(text = '') {
  const raw = String(text || '').trim()
  if (/^[a-zA-Z0-9_-]{11}$/.test(raw)) return raw
  return raw.match(/(?:youtu\.be\/|youtube\.com\/(?:watch\?v=|embed\/|shorts\/|live\/|v\/)|[?&]v=)([a-zA-Z0-9_-]{11})/)?.[1] || null
}
function sanitizeFileName(name = 'video') {
  return String(name).replace(/[\\/:*?"<>|]/g, '').replace(/\s+/g, ' ').trim().slice(0, 120) || 'video'
}